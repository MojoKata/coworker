# The shared Windows 10 VM, win10: what `vms create win10` builds it from (README.md here; the
# coworker README, "VMs"). A change here is a change to every project's test machine: the owner's.
VM_OS="Windows 10 Pro 22H2"
IMAGE=dockurr/windows@sha256:16fd7c39a3e48bb946d29c59dc6015942e5b900a1fa5d7e5552053bfc48ee2ea   # dockurr/windows, 2026-10-05
WIN_VERSION=10                # dockurr's VERSION: Windows 10 Pro 22H2, not an evaluation (no 90-day expiry)
RAM=8G
CPUS=4
DISK=64G
USERNAME=tester               # the account the projects' scripts reach over SSH (vm.env's VM_SSH_USER)
SSH_PORT=2222                 # on 127.0.0.1, like the screen (8006) and RDP (3389)
WEB_PORT=8006
RDP_PORT=3389
# OpenSSH for Windows, which oem/install.bat installs at the end of setup
OPENSSH_URL=https://github.com/PowerShell/Win32-OpenSSH/releases/download/10.0.0.0p2-Preview/OpenSSH-Win64.zip
OPENSSH_SHA256=23f50f3458c4c5d0b12217c6a5ddfde0137210a30fa870e98b29827f7b43aba5
# an installer ISO in $COWORKER_HOME/downloads that dockurr boots instead of downloading its own
# (about 5 GB); without it dockurr fetches one from Microsoft
ISO=win10x64.iso
